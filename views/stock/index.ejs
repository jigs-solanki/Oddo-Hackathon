<div class="page-header">
  <h2>Stock</h2>
  <p class="muted">List the available stock and update quantities.</p>
</div>

<div class="history-table-wrap">
  <table class="history-table striped">
    <thead>
      <tr>
        <th>Product</th>
        <th>Per Unit Cost</th>
        <th>On Hand</th>
        <th>Adjusted</th>
        <th>Free to Use</th>
      </tr>
    </thead>
    <tbody>
      <% if (!products || products.length === 0) { %>
        <tr><td colspan="5" class="muted">No products found</td></tr>
      <% } %>
      <% products.forEach(function(p){ %>
        <tr>
          <td><strong><%= p.name %></strong><div class="muted"><%= p.sku %></div></td>
          <td><%= p.cost ? (p.cost.toLocaleString() + '') : '-' %></td>
          <td><%= typeof p.stock !== 'undefined' ? p.stock : 0 %></td>
          <td><%= typeof p.reserved !== 'undefined' ? p.reserved : 0 %></td>
          <td><%= (typeof p.stock !== 'undefined' ? p.stock : 0) - (typeof p.reserved !== 'undefined' ? p.reserved : 0) %></td>
          <td>
            <form action="/stock/<%= p._id %>/update" method="post" style="display:flex; gap:8px; align-items:center">
              <input name="stock" type="number" value="<%= typeof p.stock !== 'undefined' ? p.stock : 0 %>" min="0" style="width:80px" />
              <button class="btn small">Save</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

