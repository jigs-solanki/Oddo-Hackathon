<div class="form-card">
  <h2>Create Product</h2>
  <form action="/products/create" method="post" class="form-grid">
    <div class="form-row">
      <label for="name">Name</label>
      <input id="name" name="name" required />
    </div>

    <div class="form-row">
      <label for="sku">SKU</label>
      <input id="sku" name="sku" required />
    </div>

    <div class="form-row">
      <label for="category">Category</label>
      <input id="category" name="category" />
    </div>

    <div class="form-row">
      <label for="unit">Unit</label>
      <input id="unit" name="unit" />
    </div>

    <div class="form-row">
      <label for="stock">Initial Stock</label>
      <input id="stock" name="stock" type="number" value="0" />
    </div>

    <div class="form-row">
      <label for="location">Location</label>
      <input id="location" name="location" value="Main Warehouse" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn accent">Create</button>
    </div>
  </form>
</div>
