

<div class="sm-container">
  <div class="page-header">
    <h2>Warehouse</h2>
    <p class="sm-muted">This page contains the warehouse details & location.</p>
  </div>

  <div class="sm-form-card">
    <form action="/warehouse" method="post">
      <div class="sm-form-row">
        <label>Name:</label>
        <input type="text" name="name" placeholder="Warehouse name" />
      </div>

      <div class="sm-form-row">
        <label>Short Code:</label>
        <input type="text" name="code" placeholder="WH" />
      </div>

      <div class="sm-form-row">
        <label>Address:</label>
        <input type="text" name="address" placeholder="Address" />
      </div>

      <div class="sm-form-row">
        <button class="sm-btn">Save</button>
      </div>

    </form>
  </div>
</div>
